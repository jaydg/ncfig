# Homebrew formula for ncfig, installing the prebuilt release binaries.
# Generated by scripts/homebrew-formula.sh from this template; the release
# workflow pushes the result to the tap repository as Formula/ncfig.rb.
class Ncfig < Formula
  desc "Render FIGlet fonts in the terminal with true-color gradients and marquees"
  homepage "https://github.com/@REPO@"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/@REPO@/releases/download/v@VERSION@/ncfig-aarch64-macos.tar.gz"
      sha256 "@SHA256_aarch64_macos@"
    end
    on_intel do
      url "https://github.com/@REPO@/releases/download/v@VERSION@/ncfig-x86_64-macos.tar.gz"
      sha256 "@SHA256_x86_64_macos@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/@REPO@/releases/download/v@VERSION@/ncfig-aarch64-linux.tar.gz"
      sha256 "@SHA256_aarch64_linux@"
    end
    on_intel do
      url "https://github.com/@REPO@/releases/download/v@VERSION@/ncfig-x86_64-linux.tar.gz"
      sha256 "@SHA256_x86_64_linux@"
    end
  end

  def install
    bin.install "ncfig", "ncmarquee"
    # the tools find fonts given by name in ../share/ncfig/fonts next to bin/
    pkgshare.install "fonts"
  end

  test do
    assert_match "Usage: ncfig", shell_output("#{bin}/ncfig --help")
    assert_match "ncfig #{version}", shell_output("#{bin}/ncfig --version")
    assert_predicate pkgshare/"fonts/banner.flf", :exist?
  end
end
